# ── Quelle: Proxia (MES), User "report" (nur lesen) ─────────────────────────
PROXIA_SQL_SERVER=PROXIA-HOST
# Port nur, wenn nicht 1433 (Format im Server-Feld: HOST,PORT) — sonst leer lassen
PROXIA_SQL_DATABASE=Proxia
PROXIA_SQL_USER=report
PROXIA_SQL_PASSWORD=HIER_PASSWORT
PROXIA_SQL_DRIVER=ODBC Driver 18 for SQL Server

# ── Ziel: SCE-Warehouse, Schema sce_mes ─────────────────────────────────────
SCE_SQL_SERVER=suhadbv6.uhde-hpt.net
SCE_SQL_DATABASE=SCE
SCE_SQL_USER=scedbuser
SCE_SQL_PASSWORD=HIER_PASSWORT
SCE_SQL_DRIVER=ODBC Driver 18 for SQL Server

# ── Verhalten ───────────────────────────────────────────────────────────────
# Poll-Intervall in Sekunden
MES_POLL_SEKUNDEN=30
# Standard-Modus, wenn in sce_mes.arbeitsplatz.transport_modus nichts steht: teil | voll
MES_STANDARD_MODUS=teil
# Regel, solange keine Sektoren gepflegt sind: arbeitsplatz (Wechsel des Arbeitsplatzes) | alle
MES_FALLBACK_REGEL=arbeitsplatz
# Erster Lauf ohne Wasserzeichen: so viele Stunden Rueckmeldungen nachladen
MES_BACKFILL_STUNDEN=12
# Rueckmeldungen so viele Minuten vor dem Wasserzeichen erneut lesen (spaet geschriebene Zeilen)
MES_UEBERLAPPUNG_MINUTEN=10

# ── Bestandsmonitor ─────────────────────────────────────────────────────────
# 0 = aus. Laeuft im selben Service wie die Transporte, Fehler halten die Transporte nie auf.
MES_BESTAND_AKTIV=1
# Wie oft der Bestand fortgeschrieben wird (Sekunden)
MES_BESTAND_SEKUNDEN=120
# Erster Lauf: so viele Tage Verlauf nachladen
MES_BESTAND_TAGE=90
# Offene Auftraege mit Proxia-Aktivitaet in diesem Zeitraum zusaetzlich aufnehmen (lange liegende Ware)
MES_BESTAND_SCOPE_TAGE=365
# Arbeitsplaetze ohne echten Bearbeitungsschritt (Vorschlag fuer arbeitsplatz.art = pseudo)
MES_PSEUDO_ARBEITSPLAETZE=10000167,10000168
# 1 = komplette Historie je Auftrag im Journal (alle Bewegungen in der Suche), 0 = vor MES_BESTAND_TAGE
# zu einem Anfangsbestand verdichten. Nach dem Umschalten: python -m mes_sync bestand-reset
MES_BESTAND_JOURNAL_VOLL=1
# Auftraege mit diesen Praefixen nicht in den Bestand aufnehmen (kommagetrennt; IH = Instandhaltung)
MES_BESTAND_AUSSCHLUSS_PRAEFIX=IH
# 0 = Push ohne Transport-App: fertige Ware liegt sofort vor dem Nachfolger.
# 1 = Milk Run live: bei Uebergaengen mit Transport "bereit beim Vorgaenger" bis zur Fahrer-Quittung.
# Nach dem Umschalten: python -m mes_sync bestand-reset
MES_BESTAND_TRANSPORT_ORT=0
